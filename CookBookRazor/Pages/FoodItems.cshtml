@page
@using CookBookLibrary.Model
@model CookBookRazor.Pages.FoodItems

@{
    ViewData["Title"] = "Food items";
}

<header class="page-header">
    <div class="page-header__text">
        <h1>Food items</h1>
        <p class="lead">Nutrition per 100 g for every food item you can use in a recipe.</p>
        
        <!-- Category filter -->
        <form method="get" class="category-filter">
            <fieldset class="category-filter__group">
                <legend class="category-filter__legend">Filter by category</legend>
                <ul class="category-filter__list">
                    @foreach (FoodCategory category in Enum.GetValues<FoodCategory>())
                    {
                        <li>
                            <label class="category-chip">
                                <input type="checkbox" name="categories" value="@category"
                                       checked="@Model.Categories.Contains(category)"
                                       onchange="this.form.requestSubmit()" />
                                <span>@PrettyName(category)</span>
                            </label>
                        </li>
                    }
                </ul>
            </fieldset>
            <noscript><button class="btn btn--small" type="submit">Apply</button></noscript>
            @if (Model.Categories.Any())
            {
                <a class="category-filter__clear" asp-page="/FoodItems">Clear filter</a>
            }
        </form>
        
        <!-- Search -->
        <div class="food-search">
            <label for="food-search" class="food-search__label">Search</label>
            <input type="search" id="food-search" class="food-search__input"
                   placeholder="Search food items…" autocomplete="off" />
        </div>
        
    </div>
    <div class="page-header__actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn" asp-page="/admin/CreateFoodItem">Create food item</a>
        }
    </div>
</header>

@if (!Model.allFoodItems.Any())
{
    <div class="empty-state">
        <p>There are no food items yet. <a asp-page="/admin/CreateFoodItem">Create the first one</a>.</p>
    </div>
}
else
{
    <div class="food-grid">
        @foreach (FoodItem foodItem in Model.allFoodItems)
        {
            <article class="food-card" data-name="@foodItem.Name.ToLower()">
                <div class="nutrition food-card__label">
                    <h2 class="nutrition__title food-card__name">@foodItem.Name</h2>
                    <p class="food-card__category">@foodItem.Category</p>
                    <p class="nutrition__basis">Per 100 g</p>
                    <table class="nutrition__table">
                        <tbody>
                        <tr class="nutrition__row--energy">
                            <th scope="row">Calories</th>
                            <td>@foodItem.Calories kcal</td>
                        </tr>
                        <tr>
                            <th scope="row">Fat</th>
                            <td>@foodItem.Fat g</td>
                        </tr>
                        <tr class="nutrition__row--sub">
                            <th scope="row">Saturated fat</th>
                            <td>@foodItem.SaturatedFat g</td>
                        </tr>
                        <tr>
                            <th scope="row">Carbs</th>
                            <td>@foodItem.Carbs g</td>
                        </tr>
                        <tr class="nutrition__row--sub">
                            <th scope="row">Sugar</th>
                            <td>@foodItem.Sugar g</td>
                        </tr>
                        <tr>
                            <th scope="row">Fiber</th>
                            <td>@foodItem.Fiber g</td>
                        </tr>
                        <tr>
                            <th scope="row">Protein</th>
                            <td>@foodItem.Protein g</td>
                        </tr>
                        <tr>
                            <th scope="row">Salt</th>
                            <td>@foodItem.Salt g</td>
                        </tr>
                        </tbody>
                    </table>
                </div>

                <div class="food-card__actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/admin/EditFoodItem" asp-route-id="@foodItem.Id">Edit food item</a>
                    }
                </div>
            </article>
        }
    </div>
    <p class="food-search__empty" id="food-search-empty" hidden>No food items match your search.</p>
}

@functions {
    private static string PrettyName(FoodCategory category)
    {
        string spaced = System.Text.RegularExpressions.Regex.Replace(category.ToString(), "(?<!^)([A-Z])", " $1");
        return spaced[0] + spaced[1..].ToLower();
    }
}

@section Scripts {
    <script>
        const searchInput = document.getElementById("food-search");
        const cards = document.querySelectorAll(".food-card");
        const emptyMessage = document.getElementById("food-search-empty");

        searchInput.addEventListener("input", () => {
            const query = searchInput.value.trim().toLowerCase();
            let visible = 0;

            cards.forEach(card => {
                const match = card.dataset.name.includes(query);
                card.hidden = !match;
                if (match) visible++;
            });

            if (emptyMessage) emptyMessage.hidden = visible > 0;
        });
    </script>
}