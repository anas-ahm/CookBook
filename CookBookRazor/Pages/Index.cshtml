@page
@model IndexModel
@using CookBookLibrary.Model
@{}

<div class="container">
    
</div>

<a asp-page="/CreateRecipe">Create Recipe</a>

<a asp-page="/CreateFoodItem">Create Food Items</a>


<!-- See all Recipes-->
<div class="container">
    
    @foreach (Recipe recipe in Model.allRecipes)
    {
        <div class="recipe-card">
            
            <div>
                <img/>
                <h5>@recipe._name</h5>
                <p>@recipe._description</p>
                <a asp-page="/RecipeDetails" asp-route-id="@recipe._id">See Full Recipe</a>
            </div>
        </div>
    }
</div>