@page
@model IndexModel
@using CookBookLibrary.Model
@{}

<div class="container">
    
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <h1>Hello Admin</h1>
}


<a asp-page="/admin/CreateRecipe">Create Recipe</a>

<a asp-page="/admin/CreateFoodItem">Create Food Items</a>

<a asp-page="/FoodItems">See all food items</a>

<!-- See all Recipes-->
<div class="container">
    
    @foreach (Recipe recipe in Model.allRecipes)
    {
        <div class="recipe-card">
            
            <div>
                <img/>
                <h5>@recipe._name</h5>
                <p>@recipe._description</p>
                <a asp-page="/RecipeDetails" asp-route-id="@recipe._id">See Full Recipe</a>
                <a asp-page="/admin/EditRecipe" asp-route-id="@recipe._id">Edit Recipe</a>
            </div>
        </div>
    }
</div>