@page
@model CookBookRazor.Pages.RecipeDetails
@using CookBookLibrary.Model

@{
    ViewData["Title"] = Model.recipeToShow._name;

    string recipeName = Model.recipeToShow._name ?? "";
    string initial = recipeName.Trim().Length > 0 ? recipeName.Trim().Substring(0, 1).ToUpper() : "?";
}

<article class="recipe">

    <div class="recipe__topbar">
        <a class="back-link" asp-page="/Index">All recipes</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn--ghost btn--small" asp-page="/admin/EditRecipe" asp-route-id="@Model.recipeToShow._id">Edit recipe</a>
        }
    </div>

    <header class="recipe__header">
        <div class="recipe__intro">
            <h1 class="recipe__title">@Model.recipeToShow._name</h1>
            <p class="lead recipe__description">@Model.recipeToShow._description</p>
        </div>

        @* Image: placeholder until recipes have photos. Swap the div for:
           <img class="recipe__image" src="..." alt="" /> *@
        <div class="plate-frame recipe__plate" aria-hidden="true">
            <span class="plate">@initial</span>
        </div>
    </header>

    <div class="recipe__body">

        <div class="recipe__main">
            <section class="recipe__section">
                <h2 class="recipe__heading">Ingredients</h2>

                @if (Model.recipeToShow._ingredients.Count == 0)
                {
                    <p class="muted">No ingredients added yet.</p>
                }
                else
                {
                    <ul class="ingredient-list">
                        @foreach (RecipeIngredient item in Model.recipeToShow._ingredients)
                        {
                            <li class="ingredient-list__item">
                                <span class="ingredient-list__name">@item.FoodItem.Name</span>
                                <span class="ingredient-list__amount">@item.Grams g</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="recipe__section">
                <h2 class="recipe__heading">Instructions</h2>
                <p class="recipe__instructions">@Model.recipeToShow._instructions</p>
            </section>
        </div>

        <aside class="recipe__aside">
            <section class="nutrition">
                <h2 class="nutrition__title">Nutrition</h2>
                <table class="nutrition__table">
                    <tbody>
                        <tr class="nutrition__row--energy">
                            <th scope="row">Calories</th>
                            <td>@Model.Calories kcal</td>
                        </tr>
                        <tr>
                            <th scope="row">Fat</th>
                            <td>@Model.Fat g</td>
                        </tr>
                        <tr class="nutrition__row--sub">
                            <th scope="row">Saturated fat</th>
                            <td>@Model.SaturatedFat g</td>
                        </tr>
                        <tr>
                            <th scope="row">Carbs</th>
                            <td>@Model.Carbs g</td>
                        </tr>
                        <tr class="nutrition__row--sub">
                            <th scope="row">Sugar</th>
                            <td>@Model.Sugar g</td>
                        </tr>
                        <tr>
                            <th scope="row">Fiber</th>
                            <td>@Model.Fiber g</td>
                        </tr>
                        <tr>
                            <th scope="row">Protein</th>
                            <td>@Model.Protein g</td>
                        </tr>
                        <tr>
                            <th scope="row">Salt</th>
                            <td>@Model.Salt g</td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </aside>

    </div>
</article>
