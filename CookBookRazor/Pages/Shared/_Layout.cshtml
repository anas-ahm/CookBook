<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - CookBookRazor</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/CookBookRazor.styles.css" asp-append-version="true"/>
</head>
<body>

<header class="site-header">
<a class="site-header__brand" asp-page="/Index">CookBook</a>

<nav class="site-header__nav">
    <a asp-page="/FoodItems">Food items</a>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <li><a asp-page="/auth/Logout">Logout</a></li>
    }
    else
    {
        <a asp-page="/auth/Login">Login</a>
    }
    
</nav>

</header>

<div class="container">
    <main role="main" class="pb-3">

        @if (TempData["successMessage"] != null)
        {
            <div class="success-message">
                @TempData["successMessage"]
            </div>
        }

        @if (TempData["errorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["errorMessage"]
            </div>
        }

        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - CookBookRazor - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>