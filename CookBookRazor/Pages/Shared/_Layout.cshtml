<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - CookBook</title>
    <script type="importmap"></script>

    <!-- Fonts: Young Serif (headings) + Archivo (text) -->
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Young+Serif&display=swap"/>

    <!-- Shared styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <!-- Page styles: every Page.cshtml.css file, bundled automatically by ASP.NET -->
    <link rel="stylesheet" href="~/CookBookRazor.styles.css" asp-append-version="true"/>
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
    <div class="container site-header__inner">
        <a class="site-header__brand" asp-page="/Index">Anas's CookBook</a>

        <nav class="site-header__nav" aria-label="Main">
            <a asp-page="/Index">Recipes</a>
            <a asp-page="/FoodItems">Food items</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/auth/Logout">Logout</a>
            }
            else
            {
                <a asp-page="/auth/Login">Login</a>
            }
        </nav>
    </div>
</header>

<main id="main" class="site-main">
    <div class="container">

        @if (TempData["successMessage"] != null)
        {
            <div class="flash flash--success" role="status">
                @TempData["successMessage"]
            </div>
        }

        @if (TempData["errorMessage"] != null)
        {
            <div class="flash flash--error" role="alert">
                @TempData["errorMessage"]
            </div>
        }

        @RenderBody()
    </div>
</main>

<footer class="site-footer">
    <div class="container">
        &copy; 2026 - CookBookRazor - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
