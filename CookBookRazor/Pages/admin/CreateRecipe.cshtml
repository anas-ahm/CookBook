@page
@model CookBookRazor.Pages.CreateRecipe

@{
}


@if (TempData["errorMessage"] == null && TempData["sucessMessage"] == null)
{
    <div class="container">

        <form method="post" asp-page-handler="CreateRecipe">

            <label asp-for="recipeToCreate._name">Name</label>
            <input asp-for="recipeToCreate._name"/>

            <label asp-for="recipeToCreate._description">Description</label>
            <input asp-for="recipeToCreate._description"/>

            <label asp-for="recipeToCreate._instructions">Instructions</label>
            <input asp-for="recipeToCreate._instructions"/>
        
            <h4>Ingredients</h4>
        
            <!-- Ingredient selection for Recipe-->
            <div id="ingredient-rows">
                <div class="ingredient-row">
                    <select name="recipeToCreate._ingredients[0].FoodItem.Id">
                        <option value="">-- Select food item --</option>
                        @if (Model.FoodItems != null)
                        {
                            @foreach (var food in Model.FoodItems)
                            {
                                <option value="@food.Id">@food.Name</option>
                            }
                        }
                    </select>

                    <input type="number" step="any" min="1"
                           name="recipeToCreate._ingredients[0].Grams"
                           placeholder="Grams" />
                </div>
            </div>
            
            <button type="button" id="add-ingredient">+ Add ingredient</button>
            
            <button type="submit">Create</button>

        </form>
    </div>
}


<!-- Script for add new ingredient row -->
<script>
    let nextIndex = 1;

    document.getElementById("add-ingredient").addEventListener("click", function () {
        const container = document.getElementById("ingredient-rows");

        // Copy the first row, give its fields the next index, and clear the values
        const row = container.querySelector(".ingredient-row").cloneNode(true);
        row.querySelectorAll("select, input").forEach(function (el) {
            el.name = el.name.replace(/\[\d+\]/, "[" + nextIndex + "]");
            el.value = "";
        });

        container.appendChild(row);
        nextIndex++;
    });
</script>

