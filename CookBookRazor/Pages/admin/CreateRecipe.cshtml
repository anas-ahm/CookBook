@page
@model CookBookRazor.Pages.CreateRecipe

@{
    ViewData["Title"] = "Create recipe";
}

<div class="form-page">

    <header class="page-header">
        <div class="page-header__text">
            <a class="back-link" asp-page="/Index">All recipes</a>
            <h1>Create recipe</h1>
            <p class="lead">Name the recipe, add the food items it uses, and write down the steps.</p>
        </div>
    </header>
    
        <form method="post" enctype="multipart/form-data" asp-page-handler="CreateRecipe" class="form surface">

            <div class="form__field">
                <label asp-for="recipeToCreate._name">Name</label>
                <input asp-for="recipeToCreate._name"/>
            </div>

            <div class="form__field">
                <label asp-for="recipeToCreate._description">Description</label>
                <textarea asp-for="recipeToCreate._description" rows="2"></textarea>
            </div>

            <!-- Ingredient selection for Recipe -->
            <fieldset class="ingredients">
                <legend>Ingredients</legend>
                <p class="ingredients__hint">Choose a food item and how many grams the recipe uses.</p>

                <div id="ingredient-rows" class="ingredients__rows">
                    <div class="ingredient-row">
                        <select name="recipeToCreate._ingredients[0].FoodItem.Id" aria-label="Food item">
                            <option value="">-- Select food item --</option>
                            @if (Model.FoodItems != null)
                            {
                                @foreach (var food in Model.FoodItems)
                                {
                                    <option value="@food.Id">@food.Name</option>
                                }
                            }
                        </select>

                        <input type="number" step="any" min="1"
                               name="recipeToCreate._ingredients[0].Grams"
                               placeholder="Grams" aria-label="Grams" />
                    </div>
                </div>

                <button type="button" id="add-ingredient" class="btn btn--ghost btn--small">+ Add ingredient</button>
            </fieldset>
            
            <div class="form__field">
                <label for="image">Picture (optional)</label>
                <input type="file" id="image" name="image" accept="image/*" />
            </div>

            <div class="form__field">
                <label asp-for="recipeToCreate._instructions">Instructions</label>
                <textarea asp-for="recipeToCreate._instructions" rows="8"></textarea>
            </div>

            <div class="form__actions">
                <button type="submit" class="btn">Create recipe</button>
                <a class="btn btn--ghost" asp-page="/Index">Cancel</a>
            </div>

        </form>
</div>


<!-- Script for add new ingredient row -->
<script>
    let nextIndex = 1;

    document.getElementById("add-ingredient").addEventListener("click", function () {
        const container = document.getElementById("ingredient-rows");

        // Copy the first row, give its fields the next index, and clear the values
        const row = container.querySelector(".ingredient-row").cloneNode(true);
        row.querySelectorAll("select, input").forEach(function (el) {
            el.name = el.name.replace(/\[\d+\]/, "[" + nextIndex + "]");
            el.value = "";
        });

        container.appendChild(row);
        nextIndex++;
    });
</script>
