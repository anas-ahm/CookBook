@page "{id:int}"
@using CookBookLibrary.Model
@model CookBookRazor.Pages.EditRecipe

@{
    ViewData["Title"] = "Edit recipe";
}

<div class="form-page">

    <header class="page-header">
        <div class="page-header__text">
            <a class="back-link" asp-page="/Index">All recipes</a>
            <h1>Edit recipe</h1>
            <p class="lead">Change the name, the food items it uses, or the steps.</p>
        </div>
    </header>

    <form method="post" class="form surface">

        <input type="hidden" asp-for="RecipeToEdit._id"/>

        <div class="form__field">
            <label asp-for="RecipeToEdit._name">Name</label>
            <input asp-for="RecipeToEdit._name"/>
            <span asp-validation-for="RecipeToEdit._name" class="text-danger"></span>
        </div>

        <div class="form__field">
            <label asp-for="RecipeToEdit._description">Description</label>
            <textarea asp-for="RecipeToEdit._description" rows="2"></textarea>
            <span asp-validation-for="RecipeToEdit._description" class="text-danger"></span>
        </div>

        <fieldset class="ingredients">
            <legend>Ingredients</legend>
            <p class="ingredients__hint">Choose a food item and how many grams the recipe uses.</p>

            <div id="ingredient-rows" class="ingredients__rows">
                @for (int i = 0; i < Math.Max(Model.RecipeToEdit._ingredients?.Count ?? 0, 1); i++)
                {
                    RecipeIngredient? current = i < (Model.RecipeToEdit._ingredients?.Count ?? 0)
                        ? Model.RecipeToEdit._ingredients![i]
                        : null;

                    <div class="ingredient-row">
                        <select name="RecipeToEdit._ingredients[@i].FoodItem.Id" aria-label="Food item">
                            <option value="">-- Select food item --</option>
                            @if (Model.FoodItems != null)
                            {
                                @foreach (var food in Model.FoodItems)
                                {
                                    <option value="@food.Id" selected="@(current?.FoodItem?.Id == food.Id)">@food.Name</option>
                                }
                            }
                        </select>

                        <input type="number" step="any" min="1"
                               name="RecipeToEdit._ingredients[@i].Grams"
                               value="@(current?.Grams)"
                               placeholder="Grams" aria-label="Grams"/>
                    </div>
                }
            </div>

            <button type="button" id="add-ingredient" class="btn btn--ghost btn--small">+ Add ingredient</button>
        </fieldset>

        <div class="form__field">
            <label asp-for="RecipeToEdit._instructions">Instructions</label>
            <textarea asp-for="RecipeToEdit._instructions" rows="8"></textarea>
            <span asp-validation-for="RecipeToEdit._instructions" class="text-danger"></span>
        </div>

        <div class="form__actions">
            <button type="submit" class="btn">Save changes</button>
            <a class="btn btn--ghost" asp-page="/Recipes">Cancel</a>
        </div>

    </form>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <section class="danger-zone" aria-labelledby="delete-recipe-title">
            <div class="danger-zone__text">
                <h2 id="delete-recipe-title" class="danger-zone__title">Delete this recipe</h2>
                <p class="danger-zone__body">The recipe is removed for good. This cannot be undone.</p>
            </div>

            <form method="post" asp-page-handler="Delete"
                  onsubmit="return confirm('Delete this recipe? This cannot be undone.');">
                <button type="submit" class="btn btn--danger">Delete recipe</button>
            </form>
        </section>
    }
</div>

<script>
    let nextIndex = @Math.Max(Model.RecipeToEdit._ingredients?.Count ?? 0, 1);

    document.getElementById("add-ingredient").addEventListener("click", function () {
        const container = document.getElementById("ingredient-rows");

        // Copy the first row, give its fields the next index, and clear the values
        const row = container.querySelector(".ingredient-row").cloneNode(true);
        row.querySelectorAll("select, input").forEach(function (el) {
            el.name = el.name.replace(/\[\d+\]/, "[" + nextIndex + "]");
            el.value = "";
        });

        container.appendChild(row);
        nextIndex++;
    });
</script>
